{
  "name": "lojaqa-automacao-banca",
  "version": "2.0.0",
  "description": "Suíte de Testes Automatizados E2E (UI) e API REST com Playwright + TypeScript — Módulo Painel do Cliente: Pedidos & Rastreio (LojaQA FAP 2026) + cenários externos (Diario de Pernambuco / DummyJSON)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:lento": "SLOW_MO=1000 playwright test tests/e2e/lojaQA-mcliente.spec.ts --headed",
    "test:lento:tudo": "SLOW_MO=1000 playwright test --headed",
    "test:banca": "playwright test --headed",
    "test:e2e": "playwright test tests/e2e --headed",
    "test:api": "playwright test tests/api",
    "test:lojaqa": "playwright test tests/e2e/lojaQA-mcliente.spec.ts tests/api/lojaQA-apicliente.spec.ts",
    "test:pedidos": "playwright test tests/e2e/lojaQA-mcliente.spec.ts --headed",
    "test:contrato": "playwright test tests/api/lojaQA-apicliente.spec.ts",
    "test:diario": "playwright test tests/e2e/diariodepernambuco.spec.ts --headed",
    "test:externos": "playwright test tests/e2e/diariodepernambuco.spec.ts tests/api/dummyjson.spec.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "e2e",
    "api-testing",
    "page-object-model",
    "lojaqa",
    "pedidos",
    "rastreio",
    "fap2026",
    "jornalismo",
    "diario-de-pernambuco"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
